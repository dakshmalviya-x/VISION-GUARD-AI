{
  "manifest_version": 3,
  "name": "VisionGuard – Privacy Shield",
  "version": "1.0.0",
  "description": "AI-powered shoulder-surf detector. Blurs sensitive webpage content when unauthorized viewers are detected via your webcam.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "VisionGuard Privacy Shield"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [],
  "web_accessible_resources": [
    {
      "resources": [
        "models/*-weights_manifest.json",
        "models/*.bin"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
